---
import { Image } from "astro:assets";

export interface Slide {
  /** Short name, shown in the feature picker. */
  name: string;
  title: string;
  body: string;
  image: ImageMetadata;
  alt: string;
  /** Widest the screenshot is shown, in rem. Popovers stay near life size. */
  maxWidth?: number;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<!-- The runway. It is longer than the carousel by one stretch of scrolling for
     every slide: the carousel stays in view while the page scrolls through it,
     and each stretch shows the next slide. -->
<div class="fc-runway" data-carousel style={`--fc-steps: ${slides.length}`}>
<div class="fc" aria-roledescription="carousel" aria-label="DeskShift features">
  <ul class="fc-tabs" data-tabs>
    {
      slides.map((slide, i) => (
        <li class="fc-tab" data-tab data-active={i === 0 ? "" : undefined}>
          <button type="button" aria-current={i === 0 ? "true" : undefined}>
            {slide.name}
          </button>
          <div class="fc-more">
            <div>
              <p class="fc-more-title">{slide.title}</p>
              <p>{slide.body}</p>
            </div>
          </div>
          <span class="fc-progress" aria-hidden="true">
            <span data-progress />
          </span>
        </li>
      ))
    }
  </ul>

  <div class="fc-stage">
    <div class="fc-track" data-track>
      {
        slides.map((slide, i) => (
          <figure
            class="fc-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length}: ${slide.name}`}
          >
            <div class="fc-shot" style={slide.maxWidth ? `--shot-max: ${slide.maxWidth}rem` : undefined}>
              <Image
                src={slide.image}
                alt={slide.alt}
                widths={[640, 960, 1280, 1920]}
                sizes="(min-width: 64rem) 42rem, 92vw"
                loading="lazy"
              />
            </div>
            <figcaption class="fc-caption">
              <h3>{slide.title}</h3>
              <p>{slide.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="fc-controls">
      <span class="fc-counter" data-counter aria-hidden="true">
        1 / {slides.length}
      </span>
      <button type="button" data-step="-1" aria-label="Previous feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 6 8.5 12l6 6"></path>
        </svg>
      </button>
      <button type="button" data-step="1" aria-label="Next feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9.5 6 6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
</div>

<style>
  .fc {
    display: grid;
    gap: 1.25rem;
  }

  /* The picker. A row of chips on small screens, a list beside the stage on
     large ones, where the current feature opens to show its description. */
  .fc-tabs {
    display: flex;
    gap: 0.5rem;
    margin-inline: -1.5rem;
    padding: 0.25rem 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fc-tabs::-webkit-scrollbar {
    display: none;
  }

  .fc-tab {
    position: relative;
    flex: none;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition: border-color 0.3s ease;
  }
  .fc-tab[data-active] {
    border-color: var(--color-accent);
    /* Half a pixel more outline, without moving the capsules beside it. */
    box-shadow: 0 0 0 0.5px var(--color-accent);
  }

  .fc-tab button {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.95rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .fc-tab button:hover {
    color: var(--color-fg);
  }
  /* The current capsule's name is white over the fill and the page's own
     colour past it: the letters change where the fill ends. */
  .fc-tab[data-active] button {
    background: linear-gradient(to right, #fff calc(var(--fc-fill, 1) * 100%), var(--color-fg) 0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fc-more {
    display: none;
  }

  /* Marks the current feature. Where scrolling picks the slide, it fills as the
     page scrolls toward the next one. */
  .fc-progress {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fc-progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .fc-tab[data-active] .fc-progress span {
    transform: scaleX(var(--fc-fill, 1));
  }

  /* The stage: one screenshot per slide, swiped or scrolled sideways. */
  .fc-stage {
    min-width: 0;
  }

  .fc-track {
    position: relative;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    transition: opacity 0.2s ease;
  }
  .fc-track::-webkit-scrollbar {
    display: none;
  }
  .fc-track.is-fading {
    opacity: 0;
  }

  .fc-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .fc-shot {
    --pad: 0.5rem;
    position: relative;
    /* The full width, even where the height below cuts the 8:7 short. */
    width: 100%;
    aspect-ratio: 8 / 7;
    /* The script sets this where the carousel is pinned, to fit the window. */
    max-height: var(--fc-shot-max, none);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 1.5rem;
    background:
      radial-gradient(110% 80% at 50% 0%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 65%),
      var(--color-surface-2);
  }
  /* The <img> comes from Astro's Image component, outside this scope. */
  .fc-shot :global(img) {
    position: absolute;
    inset: var(--pad);
    width: calc(100% - 2 * var(--pad));
    max-width: var(--shot-max, none);
    height: calc(100% - 2 * var(--pad));
    margin: auto;
    object-fit: contain;
  }

  .fc-caption {
    padding: 1.1rem 0.25rem 0;
  }
  .fc-caption h3 {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .fc-caption p {
    margin-top: 0.4rem;
    color: var(--color-muted);
  }

  .fc-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .fc-counter {
    margin-right: auto;
    padding-left: 0.25rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .fc-controls button {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-fg) 8%, transparent);
    color: var(--color-fg);
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }
  .fc-controls button:hover {
    background: color-mix(in srgb, var(--color-fg) 16%, transparent);
  }
  .fc-controls button:active {
    transform: scale(0.92);
  }
  .fc-controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .fc-controls svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (min-width: 64rem) {
    .fc {
      grid-template-columns: 21rem minmax(0, 1fr);
      align-items: start;
      gap: 3.5rem;
    }

    .fc-tabs {
      display: block;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .fc-tab {
      padding: 1rem 0;
      border: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
      border-radius: 0;
    }

    .fc-tab button {
      position: static;
      padding: 0;
      font-size: 1.0625rem;
      letter-spacing: -0.01em;
    }
    /* The whole row is the button's hit area. */
    .fc-tab button::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .fc-more {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.5s var(--ease-out),
        opacity 0.4s ease;
    }
    .fc-tab[data-active] .fc-more {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .fc-more > div {
      min-height: 0;
      overflow: hidden;
    }
    .fc-more p {
      padding-top: 0.35rem;
      color: var(--color-muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .fc-more .fc-more-title {
      padding-top: 0.5rem;
      color: var(--color-fg);
      font-weight: 500;
    }

    /* A bar under the current feature, on a faint track. */
    .fc-tab[data-active] {
      border-color: color-mix(in srgb, var(--color-border) 70%, transparent);
      box-shadow: none;
    }
    .fc-tab[data-active] button {
      background: none;
      color: var(--color-fg);
    }
    .fc-progress {
      inset: auto 0 0;
      height: 3px;
      overflow: hidden;
      border-radius: 999px;
    }
    .fc-tab[data-active] .fc-progress {
      background: color-mix(in srgb, var(--color-fg) 14%, transparent);
    }
    .fc-progress span {
      border-radius: inherit;
      background: var(--color-accent);
    }

    .fc-shot {
      --pad: 1.25rem;
      border-radius: 1.75rem;
    }

    .fc-caption {
      display: none;
    }
  }

  /* Scrolling picks the slide. The `js` class comes from Base.astro, and the
     script marks the runway data-static when the carousel does not fit under
     the header: either way, without them this is a plain carousel. */
  :global(.js) .fc-runway:not([data-static]) {
    --fc-step: 50vh;
  }
  :global(.js) .fc-runway:not([data-static])::after {
    content: "";
    display: block;
    height: calc(var(--fc-steps) * var(--fc-step));
  }
  :global(.js) .fc-runway:not([data-static]) .fc {
    position: sticky;
    top: var(--fc-top, 5rem);
  }
  /* The page's scrolling moves the track. It does not follow a finger: the
     script turns a sideways swipe into a step. */
  :global(.js) .fc-runway:not([data-static]) .fc-track {
    overflow-x: hidden;
    touch-action: pan-y pinch-zoom;
  }

  @media (min-width: 64rem) and (max-height: 46rem) {
    .fc-tab {
      padding: 0.75rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-more,
    .fc-track {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  // From this width up the picker sits beside the stage (see the styles).
  const wide = window.matchMedia("(min-width: 64rem)");

  function setUpCarousel(runway: HTMLElement) {
    const root = runway.querySelector<HTMLElement>(".fc")!;
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const tabList = root.querySelector<HTMLElement>("[data-tabs]")!;
    const tabs = Array.from(root.querySelectorAll<HTMLElement>("[data-tab]"));
    const buttons = tabs.map((tab) => tab.querySelector("button")!);
    const counter = root.querySelector<HTMLElement>("[data-counter]")!;
    const steppers = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-step]"));

    let index = 0;
    // True while the carousel stays in view and the page's scrolling picks the
    // slide. It is not where the window is too short to hold the carousel:
    // there a tap, an arrow or a swipe picks the slide.
    let pinned = false;
    // Where the pinned carousel sits, in pixels from the top of the window.
    let pinTop = 0;
    // True while the carousel scrolls the track itself, so that scrolling is
    // not mistaken for a swipe.
    let scripted = false;
    let scriptedTimer = 0;

    const smooth = () => (reducedMotion.matches ? "instant" : "smooth");
    const lastIndex = slides.length - 1;

    // The window's height with the browser's own bars showing. On a phone it
    // stays the same as they slide away, so the pinned carousel does not jump.
    const probe = document.createElement("div");
    probe.style.cssText =
      "position:fixed;top:0;left:0;width:0;height:100svh;visibility:hidden;pointer-events:none";
    document.body.append(probe);
    const windowHeight = () => probe.offsetHeight || window.innerHeight;

    function markCurrent() {
      tabs.forEach((tab, i) => {
        tab.toggleAttribute("data-active", i === index);
        if (i === index) buttons[i].setAttribute("aria-current", "true");
        else buttons[i].removeAttribute("aria-current");
      });
      counter.textContent = `${index + 1} / ${slides.length}`;

      // The page has an end in each direction; the plain carousel wraps around.
      steppers.forEach((button) => {
        const next = index + Number(button.dataset.step);
        button.disabled = pinned && (next < 0 || next > lastIndex);
      });

      // Keep the current chip in view where the picker scrolls sideways.
      if (tabList.scrollWidth > tabList.clientWidth) {
        const tab = tabs[index].getBoundingClientRect();
        const list = tabList.getBoundingClientRect();
        tabList.scrollTo({
          left: tabList.scrollLeft + tab.left - list.left - (list.width - tab.width) / 2,
          behavior: smooth(),
        });
      }
    }

    function scrollTrack(behavior: ScrollBehavior) {
      scripted = true;
      window.clearTimeout(scriptedTimer);
      track.scrollTo({ left: slides[index].offsetLeft, behavior });
      scriptedTimer = window.setTimeout(() => (scripted = false), behavior === "smooth" ? 900 : 80);
    }

    /** Shows a slide of the plain carousel. */
    function show(next: number) {
      const wraps = next < 0 || next > lastIndex;
      index = (next + slides.length) % slides.length;
      markCurrent();

      // Going from the last slide back to the first, fade instead of rewinding
      // through every slide in between.
      if (wraps && !reducedMotion.matches) {
        scripted = true;
        track.classList.add("is-fading");
        window.setTimeout(() => {
          scrollTrack("instant");
          track.classList.remove("is-fading");
        }, 200);
        return;
      }
      scrollTrack(smooth());
    }

    /** How far the page scrolls while the carousel stays in view. */
    const runwayLength = () => runway.offsetHeight - root.offsetHeight;

    /** Shows the slide the page has scrolled to. */
    function follow() {
      if (!pinned) return;
      const passed = pinTop - runway.getBoundingClientRect().top;
      const position = Math.min(Math.max(passed / runwayLength(), 0), 1) * slides.length;
      const next = Math.min(lastIndex, Math.floor(position));
      root.style.setProperty("--fc-fill", Math.min(position - next, 1).toFixed(3));
      if (next === index) return;
      index = next;
      markCurrent();
      scrollTrack(smooth());
    }

    /** Goes to a slide: where the page's scrolling picks it, by scrolling there. */
    function go(next: number) {
      if (!pinned) {
        show(next);
        return;
      }
      const target = Math.min(Math.max(next, 0), lastIndex);
      const start = runway.getBoundingClientRect().top + window.scrollY - pinTop;
      // A little way into the slide's stretch, so it is clearly the current one.
      const into = ((target + 0.04) / slides.length) * runwayLength();
      window.scrollTo({ top: Math.ceil(start + into), behavior: smooth() });
    }

    /** The picker's height beside the stage, with its longest description open. */
    function pickerHeight() {
      const descriptions = tabs.map((tab) => tab.querySelector<HTMLElement>(".fc-more")!);
      const rows = tabs.reduce((sum, tab, i) => sum + tab.offsetHeight - descriptions[i].offsetHeight, 0);
      const longest = Math.max(...descriptions.map((more) => more.firstElementChild!.scrollHeight));
      return rows + longest;
    }

    // Room left around the pinned carousel, and the least a screenshot may be
    // squeezed to before the carousel is better left unpinned.
    const MARGIN = 24;
    const SMALLEST_SHOT = 220;
    let arrangedFor = "";

    /** Pins the carousel, with its screenshots as tall as the window allows. */
    function arrange() {
      const header = document.querySelector<HTMLElement>(".site-header")?.offsetHeight ?? 0;
      const room = windowHeight() - header;
      arrangedFor = `${window.innerWidth} ${windowHeight()}`;

      // Measure it as it would be pinned, with the screenshots at full height.
      runway.removeAttribute("data-static");
      runway.style.removeProperty("--fc-shot-max");
      const beside = wide.matches;
      const shot = slides[0].querySelector<HTMLElement>(".fc-shot")!.offsetHeight;
      // What stands with a screenshot: the controls and, under the picker, the
      // picker and the longest caption too.
      const rest = (beside ? root.querySelector<HTMLElement>(".fc-stage")! : root).offsetHeight - shot;
      const fitted = Math.min(shot, room - MARGIN - rest);
      const height = Math.max(rest + fitted, beside ? pickerHeight() : 0);

      pinned = fitted >= SMALLEST_SHOT && height + MARGIN <= room;
      runway.toggleAttribute("data-static", !pinned);

      if (pinned) {
        runway.style.setProperty("--fc-shot-max", `${Math.floor(fitted)}px`);
        pinTop = Math.round(header + (room - height) / 2);
        runway.style.setProperty("--fc-top", `${pinTop}px`);
        follow();
      } else {
        root.style.removeProperty("--fc-fill");
      }
      markCurrent();
      scrollTrack("instant");
    }

    let queued = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!pinned || queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          follow();
        });
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      if (arrangedFor !== `${window.innerWidth} ${windowHeight()}`) arrange();
    });

    // Pinned, the track does not scroll under a finger: a sideways swipe steps
    // to the next slide or the one before.
    let swipe: { x: number; y: number } | null = null;
    track.addEventListener("pointerdown", (event) => {
      swipe = pinned && event.pointerType === "touch" ? { x: event.clientX, y: event.clientY } : null;
    });
    track.addEventListener("pointercancel", () => (swipe = null));
    track.addEventListener("pointerup", (event) => {
      if (!swipe) return;
      const across = event.clientX - swipe.x;
      const down = event.clientY - swipe.y;
      swipe = null;
      if (Math.abs(across) > 40 && Math.abs(across) > Math.abs(down) * 1.5) go(index + (across < 0 ? 1 : -1));
    });

    // A swipe or a sideways scroll of the plain carousel: follow it.
    track.addEventListener(
      "scroll",
      () => {
        if (scripted || pinned) return;
        const nearest = slides.reduce(
          (best, slide, i) =>
            Math.abs(slide.offsetLeft - track.scrollLeft) <
            Math.abs(slides[best].offsetLeft - track.scrollLeft)
              ? i
              : best,
          0,
        );
        if (nearest === index) return;
        index = nearest;
        markCurrent();
      },
      { passive: true },
    );

    new ResizeObserver(() => scrollTrack("instant")).observe(track);

    buttons.forEach((button, i) => {
      button.addEventListener("click", () => go(i));
      button.addEventListener("keydown", (event) => {
        const steps: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
        const step = steps[event.key];
        if (!step) return;
        event.preventDefault();
        const next = pinned
          ? Math.min(Math.max(index + step, 0), lastIndex)
          : (index + step + slides.length) % slides.length;
        go(next);
        buttons[next].focus({ preventScroll: true });
      });
    });

    steppers.forEach((button) =>
      button.addEventListener("click", () => go(index + Number(button.dataset.step))),
    );

    // Fetch the screenshots just before the carousel comes into view, so no
    // slide arrives empty.
    const nearby = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        root.querySelectorAll("img").forEach((image) => (image.loading = "eager"));
        nearby.disconnect();
      },
      { rootMargin: "600px 0px" },
    );
    nearby.observe(runway);

    arrange();
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(setUpCarousel);
</script>
