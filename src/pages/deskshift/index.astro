---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import DeskDemo from "../../components/deskshift/DeskDemo.astro";
import FeatureCarousel from "../../components/deskshift/FeatureCarousel.astro";
import type { Slide } from "../../components/deskshift/FeatureCarousel.astro";
import {
  appStoreUrl,
  DISCLAIMER,
  LANGUAGES,
  MIN_MACOS,
  PRO_PRICE,
  VERSION,
  VERSION_DATE,
} from "../../lib/deskshift";

import icon from "../../assets/deskshift/icon.png";
// Window captures of the current version, with their shadow and a transparent
// background: Settings at 2x, the popover at 3x.
import positions from "../../assets/deskshift/screens/positions.png";
import postureCoach from "../../assets/deskshift/screens/posture-coach.png";
import pauseWhile from "../../assets/deskshift/screens/pause-while.png";
import shortcuts from "../../assets/deskshift/screens/shortcuts.png";
import gestures from "../../assets/deskshift/screens/gestures.png";
import menuBar from "../../assets/deskshift/screens/menu-bar.png";
import automation from "../../assets/deskshift/screens/automation.png";
import multiDesk from "../../assets/deskshift/screens/multi-desk.png";

const title = "DeskShift — Mac app for IKEA IDÅSEN standing desks";
const description =
  "Control your IKEA IDÅSEN standing desk from the Mac menu bar: memory positions, keyboard shortcuts and a Posture Coach that can move the desk for you. Free to try, one-time purchase.";

const features: Slide[] = [
  {
    name: "Memory positions",
    title: "Every height you use, one tap away",
    body: "Save up to 12 positions of your own, name them, and jump to any of them from the menu bar. Drag them into your order, and show them as a grid or a list.",
    image: positions,
    alt: "DeskShift's position editor in the menu bar popover: a Stand position at 114.5 cm with its keyboard shortcut and Posture Coach schedule.",
    maxWidth: 27,
  },
  {
    name: "Posture Coach",
    title: "A standing desk that gets you standing",
    body: "Choose how long you sit and how long you stand. When it's time, the coach reminds you, or moves the desk for you. The menu bar shows how long you've been sitting and when the next move comes.",
    image: postureCoach,
    alt: "Posture Coach settings: sitting for 27 minutes with the desk rising at 19:43, intervals of 45 minutes sitting and 15 standing, and a schedule from 09:00 to 20:00 every day.",
  },
  {
    name: "Calls and countdown",
    title: "A coach that knows when to wait",
    body: "On a call? The desk waits until it ends. Mac locked? It stays put. A 10-second countdown comes before every automatic move: skip or snooze it from the menu bar, the notification or the desk's own button.",
    image: pauseWhile,
    alt: "Posture Coach settings: automatic desk movement with a countdown before moving, and Pause While switches for a call, a locked Mac and time away from the Mac.",
  },
  {
    name: "Keyboard shortcuts",
    title: "Never leave the keyboard",
    body: "A global shortcut for every position, plus up, down and stop. Hold Move Up or Move Down to drive the desk; let go and it stops.",
    image: shortcuts,
    alt: "Keyboard Shortcuts settings: a global shortcut for each memory position and for moving up, moving down and stopping.",
  },
  {
    name: "Desk button gestures",
    title: "The desk's own button, with shortcuts",
    body: "Tap the physical button in a short sequence and the desk moves to a memory position. Give any position its own gesture of 2 to 5 up and down taps.",
    image: gestures,
    alt: "Interactions settings: desk button gestures, with two taps down for Sit, two taps up for Stand, three taps up for Max and three taps down for Min.",
  },
  {
    name: "Menu bar",
    title: "Your height, at a glance",
    body: "Show an icon, the live desk height, or both in the menu bar, in centimetres or inches. You also choose what each position card shows.",
    image: menuBar,
    alt: "Menu Bar settings: a choice of icon, live height or both, precision and unit, a grid or list layout, and what each memory position card shows.",
  },
  {
    name: "Shortcuts, Spotlight, Siri",
    title: "A step in any automation",
    body: "Six desk actions in the Shortcuts app, to combine with focus modes, timers or your morning routine. Type one into Spotlight, or name a shortcut and say it: “Hey Siri, stand up.”",
    image: automation,
    alt: "Automation settings: the six desk actions DeskShift adds to the Shortcuts app, a Spotlight example and the steps to run a shortcut with Siri.",
  },
  {
    name: "More than one desk",
    title: "Every desk you use",
    body: "Pair each desk once and switch between them in a tap. Your desk reconnects by itself when you're back in range, and iCloud keeps your desks and positions in step across your Macs.",
    image: multiDesk,
    alt: "The menu bar popover with its sidebar open: a saved desk, connected, a button to scan for new desks, and the Posture Coach's status above the memory positions.",
    maxWidth: 40,
  },
];

// What the current version brought, by theme. From the app's own release notes.
const news = [
  {
    title: "A Posture Coach you can trust",
    changes: [
      "A 10-second countdown before every automatic move. Skip or snooze it from the menu bar, the notification or the desk's own button.",
      "The coach waits while you're on a call or your Mac is locked, and can leave time away from your Mac out of your intervals.",
      "The menu bar shows how long you've been sitting or standing, and when the next move comes.",
    ],
  },
  {
    title: "Your positions, your way",
    changes: [
      "Give any memory position its own gesture on the desk's button.",
      "Drag positions into your order, and show them as a grid or a list.",
      "Choose what each card and the menu bar show.",
    ],
  },
  {
    title: "Smoother every day",
    changes: [
      "Your desk reconnects by itself when it's back in range or Bluetooth is turned back on.",
      "Release a held keyboard shortcut and the desk stops. Every time.",
      "A badge in the menu bar tells you when a new version is ready.",
    ],
  },
  {
    title: "More Macs, more languages",
    changes: [
      `Runs on macOS ${MIN_MACOS} and later.`,
      `Now in ${LANGUAGES} languages.`,
      "Settings, redesigned: Menu Bar, Interactions, Keyboard Shortcuts, Automation and Posture Coach each have their own place.",
    ],
  },
];

// `icon` is the inside of a 24 x 24 stroked SVG.
const pillars = [
  {
    title: "Health first",
    body: "Calm reminders and a Posture Coach that helps you move more without nagging.",
    icon: '<path d="M3 12h4l2.5-6 4 12 2.5-6h5"/>',
  },
  {
    title: "Comfort & ergonomics",
    body: "Tap, shortcut, or voice — no more holding a button on the side of your desk.",
    icon: '<path d="M9 9h6v6H9zM9 9V6.5A2.5 2.5 0 1 0 6.5 9H9zM15 9h2.5A2.5 2.5 0 1 0 15 6.5V9zM15 15v2.5a2.5 2.5 0 1 0 2.5-2.5H15zM9 15H6.5A2.5 2.5 0 1 0 9 17.5V15z"/>',
  },
  {
    title: "Native Mac feel",
    body: `Menu bar, SF Symbols, iCloud sync. Built in SwiftUI, in ${LANGUAGES} languages.`,
    icon: '<rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="M3 9.5h18M13.5 7h4"/>',
  },
  {
    title: "Privacy by design",
    body: "No account, no analytics, no servers. Bluetooth talks only to your desk.",
    icon: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  },
];

// Mirrors ProFeature.matrix in the DeskShift app and FreeVsPro.md §3 — Free
// first, then Pro-only, then lifetime parity.
const matrix: Array<{ feature: string; desc: string; free: boolean }> = [
  { feature: "Multi-desk support", desc: "Pair every desk you use and switch between them in a tap.", free: true },
  { feature: "Launch at login", desc: "DeskShift is ready the moment you sign in.", free: true },
  { feature: "Auto-reconnect to your last desk", desc: "Walk up and you’re connected — no fiddling with Bluetooth.", free: true },
  { feature: "iCloud sync across devices", desc: "Your desks and presets follow your Apple ID to every Mac.", free: true },
  { feature: "Manual up / down (hold to move)", desc: "Hold to raise or lower, release to stop. Simple.", free: true },
  { feature: "Sit and Stand memory positions", desc: "Two one-tap heights for the postures you use most.", free: true },

  { feature: "Create your custom memory positions", desc: "Name and shape your day — sit, stand, lean, perch — with custom icons.", free: false },
  { feature: "Desk-button double-tap gesture", desc: "Double-tap the physical button to fly to Sit or Stand.", free: false },
  { feature: "Notifications to switch positions", desc: "A gentle nudge when you’ve been sitting too long.", free: false },
  { feature: "Posture Coach automation", desc: "Custom intervals, a schedule, and auto-move on your terms.", free: false },
  { feature: "Customize the menu bar", desc: "Show an icon, the live height, or both. Your bar, your call.", free: false },
  { feature: "Live height in the menu bar", desc: "Glance up and see exactly where your desk is, in cm or inches.", free: false },
  { feature: "Siri integration", desc: "Name a shortcut once, then just say it: “Hey Siri, stand up.”", free: false },
  { feature: "Spotlight search", desc: "Type a desk action into Spotlight and hit return.", free: false },
  { feature: "Shortcuts app integration", desc: "Make your desk a step in any automation you dream up.", free: false },
  { feature: "Global keyboard shortcuts", desc: "Jump to any position from anywhere in macOS — no clicking.", free: false },

  { feature: "Lifetime Pro updates", desc: "Every Pro feature we add later stays unlocked for you. Forever.", free: false },
];

const faqs = [
  {
    q: "Which desks does DeskShift work with?",
    a: "DeskShift is built and tested on the IKEA IDÅSEN. Other desks with a Linak Bluetooth controller generally work too, but that is best-effort: the 14-day trial is the easy way to check yours.",
  },
  {
    q: "Do I need the desk's phone app?",
    a: "No. DeskShift talks to the desk directly over Bluetooth. There is nothing to install on the desk.",
  },
  {
    q: "Is it a subscription?",
    a: "No. The basics are free. Pro is a one-time purchase that covers your Family Sharing group and every Pro feature added later.",
  },
  {
    q: "What happens when the trial ends?",
    a: "DeskShift keeps working with the free features: manual up and down, Sit and Stand, launch at login, auto-reconnect, iCloud sync and multiple desks. The Pro features lock until you buy, and everything you set up is kept.",
  },
  {
    q: "Will the desk move on its own?",
    a: "Only on the schedule you set. Posture Coach can remind you, move the desk for you, or both, inside the hours and days you choose. A 10-second countdown comes before every automatic move, so you can skip or snooze it, and the coach waits while you're on a call or your Mac is locked.",
  },
  {
    q: "What does DeskShift know about me?",
    a: "Nothing. There is no account, no analytics and no tracking. Your desks and settings stay on your Mac and sync through your own iCloud. Feedback is sent only when you submit it.",
  },
  {
    q: "Which Macs does it run on?",
    a: `Any Mac with Bluetooth running macOS ${MIN_MACOS} or later.`,
  },
];

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "DeskShift",
  description,
  operatingSystem: `macOS ${MIN_MACOS} or later`,
  softwareVersion: VERSION,
  applicationCategory: "UtilitiesApplication",
  url: new URL("/deskshift/", Astro.site).toString(),
  image: new URL("/deskshift/og.png", Astro.site).toString(),
  downloadUrl: appStoreUrl(),
  installUrl: appStoreUrl(),
  author: {
    "@type": "Person",
    name: "Ionut Binisor",
    url: Astro.site?.toString(),
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base title={title} description={description} ogImage="/deskshift/og.png" wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative isolate grid items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-12">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="space-y-6">
      <Image
        src={icon}
        alt="DeskShift app icon"
        width={80}
        height={80}
        densities={[1, 2, 3]}
        loading="eager"
        class="rise h-20 w-20 drop-shadow-xl"
      />
      <p
        class="rise flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-medium tracking-wide text-(--color-accent)"
        style="--rise-delay: 60ms"
      >
        DeskShift for macOS
        <a
          href="#whats-new"
          class="rounded-full bg-(--color-accent)/12 px-3 py-1 text-xs font-semibold tracking-normal no-underline transition-colors hover:bg-(--color-accent)/20 hover:no-underline"
        >
          New: version {VERSION} ↓
        </a>
      </p>
      <h1
        class="rise text-[2.5rem] leading-[1.05] font-semibold tracking-tight sm:text-6xl"
        style="--rise-delay: 120ms"
      >
        Your desk, in the menu bar.<br />
        <span class="text-(--color-muted)">Move with a tap.</span>
      </h1>
      <p class="rise max-w-xl text-lg text-(--color-muted)" style="--rise-delay: 180ms">
        Save the heights you use, switch with a tap or a shortcut, and let
        Posture Coach raise the desk when you've sat long enough.
      </p>

      <div class="rise flex flex-wrap items-center gap-x-6 gap-y-4 pt-2" style="--rise-delay: 240ms">
        <AppStoreBadge />
        <a href="#features" class="text-sm font-medium">See what it does ↓</a>
      </div>

      <p class="rise pt-1 text-xs text-(--color-muted)" style="--rise-delay: 300ms">
        For IKEA IDÅSEN &amp; other Linak-based Bluetooth desks. macOS {MIN_MACOS} or
        later. Free to download, 14-day Pro trial.
      </p>
    </div>

    <div class="rise" style="--rise-delay: 260ms">
      <DeskDemo />
      <p class="mt-4 text-center text-sm text-(--color-muted)">
        Go on, try it: tap a position, or hold an arrow.
      </p>
    </div>
  </section>

  <!-- What it does -->
  <section id="features" class="mt-28 sm:mt-40">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">A closer look.</h2>
      <p class="mt-4 text-lg text-(--color-muted)">
        Pick a feature, or scroll through them all.
      </p>
    </div>
    <div class="mt-10 sm:mt-14" data-reveal>
      <FeatureCarousel slides={features} />
    </div>
    <p class="mt-10 text-sm text-(--color-muted)" data-reveal>
      All of this is yours for the 14-day trial. Sit, Stand and manual control
      stay free after it.
    </p>
  </section>

  <!-- What's new -->
  <section
    id="whats-new"
    class="mt-28 rounded-[2rem] border border-(--color-border)/70 bg-(--color-surface) p-8 sm:mt-40 sm:p-12"
    data-reveal
  >
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
      <div>
        <p class="text-sm font-medium tracking-wide text-(--color-accent)">
          Version {VERSION} · {VERSION_DATE}
        </p>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">What's new.</h2>
        <p class="mt-4 text-lg text-(--color-muted)">
          The biggest update so far, and a free one: get it in the Mac App
          Store.
        </p>
      </div>
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          news.map((group) => (
            <div>
              <h3 class="text-lg font-semibold tracking-tight">{group.title}</h3>
              <ul class="mt-3 space-y-2.5 text-(--color-muted)">
                {group.changes.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="mt-28 sm:mt-40">
    <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl" data-reveal>
      The thinking behind it.
    </h2>
    <div class="mt-10 grid gap-4 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p, i) => (
          <div
            class="lift rounded-3xl border border-(--color-border)/70 bg-(--color-surface) p-6"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-(--color-accent)/12 text-(--color-accent)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                aria-hidden="true"
                set:html={p.icon}
              />
            </span>
            <h3 class="mt-5 text-lg font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 text-(--color-muted)">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Free vs Pro -->
  <section id="pricing" class="mt-28 sm:mt-40">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        One price. One time. Yours forever.
      </h2>
      <p class="mt-4 text-lg text-(--color-muted)">
        Every new install starts with a 14-day full-Pro trial — no card, no
        account.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:mt-14 lg:grid-cols-2">
      <div class="rounded-3xl border border-(--color-border)/70 bg-(--color-surface) p-8" data-reveal>
        <h3 class="text-3xl font-semibold tracking-tight">Free</h3>
        <p class="mt-2 text-(--color-muted)">
          The basics, for as long as you like.
        </p>
        <ul class="mt-8 space-y-3.5">
          {
            matrix.filter((row) => row.free).map((row) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 flex-none text-(--color-muted)" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                {row.feature}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pro-card relative rounded-3xl border border-(--color-accent)/50 bg-(--color-surface) p-8" data-reveal style="--reveal-delay: 100ms">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-3xl font-semibold tracking-tight">Pro</h3>
          <span class="rounded-full bg-(--color-accent)/12 px-3 py-1 text-xs font-semibold text-(--color-accent)">
            One-time purchase
          </span>
        </div>
        <p class="mt-2 text-(--color-muted)">
          {PRO_PRICE}. No subscription.
        </p>
        <p class="mt-8 text-sm font-medium text-(--color-muted)">
          Everything in Free, and:
        </p>
        <ul class="mt-4 grid gap-x-6 gap-y-3.5 sm:grid-cols-2">
          {
            matrix.filter((row) => !row.free).map((row) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 flex-none text-(--color-accent)" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                {row.feature}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <details class="group mt-4 rounded-3xl border border-(--color-border)/70 bg-(--color-surface) [&_summary::-webkit-details-marker]:hidden" data-reveal>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-8 py-5 font-medium">
        Compare every feature
        <span class="text-xl text-(--color-muted) transition duration-300 group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <div class="overflow-x-auto border-t border-(--color-border)/60">
        <table class="w-full text-sm">
          <thead class="text-left">
            <tr>
              <th class="px-8 py-3 font-medium">Feature</th>
              <th class="px-4 py-3 text-center font-medium">Free</th>
              <th class="px-4 py-3 pr-8 text-center font-medium">Pro</th>
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((row) => (
                <tr class="border-t border-(--color-border)/60 align-top">
                  <td class="px-8 py-3">
                    <div class="font-medium">{row.feature}</div>
                    <div class="mt-0.5 text-xs text-(--color-muted)">{row.desc}</div>
                  </td>
                  <td class="px-4 py-3 text-center">
                    {row.free ? (
                      <span aria-label="Included">✓</span>
                    ) : (
                      <span class="text-(--color-muted)" aria-label="Not included">✕</span>
                    )}
                  </td>
                  <td class="px-4 py-3 pr-8 text-center">
                    <span aria-label="Included">✓</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <p class="mt-8 max-w-3xl text-base" data-reveal>
      <span class="font-semibold">Pro is a one-time purchase: {PRO_PRICE}.</span>
      The App Store shows the price in your currency. No subscription, no
      upsells. Every Pro feature today, and every Pro feature added later, stays
      unlocked on every Mac signed in to your Apple ID.
    </p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mt-28 grid gap-10 sm:mt-40 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
    <div data-reveal>
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">Questions</h2>
      <p class="mt-4 text-(--color-muted)">
        Something else? <a href="/deskshift/support">Ask me directly.</a>
      </p>
    </div>
    <div class="space-y-3" data-reveal>
      {
        faqs.map((item) => (
          <details class="group rounded-2xl border border-(--color-border)/70 bg-(--color-surface) px-6 py-5 transition-colors duration-300 hover:border-(--color-fg)/30 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
              <span class="font-medium">{item.q}</span>
              <span
                class="text-xl leading-6 text-(--color-muted) transition duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="pt-3 text-(--color-muted)">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section
    class="cta relative isolate mt-28 overflow-clip rounded-[2rem] border border-(--color-border)/70 bg-(--color-surface) px-6 py-16 text-center sm:mt-40 sm:py-24"
    data-reveal
  >
    <Image
      src={icon}
      alt=""
      width={72}
      height={72}
      densities={[1, 2, 3]}
      class="mx-auto h-18 w-18 drop-shadow-xl"
    />
    <h2 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">Try DeskShift</h2>
    <p class="mx-auto mt-4 max-w-md text-lg text-(--color-muted)">
      Full Pro free for 14 days. No card. No account. No email.
    </p>
    <div class="mt-8 flex justify-center">
      <AppStoreBadge />
    </div>
  </section>

  <p class="mt-10 text-xs text-(--color-muted)">{DISCLAIMER}</p>
</Base>

<style>
  /* A soft wash of the accent colour behind the hero and the closing panel. */
  .hero-glow {
    position: absolute;
    z-index: -1;
    inset: -10rem 0 auto 20%;
    height: 38rem;
