---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import {
  appStoreUrl,
  DISCLAIMER,
  MIN_MACOS,
  PRO_PRICE,
  SUPPORT_EMAIL,
} from "../../lib/deskshift";

import icon from "../../assets/deskshift/icon.png";
import menuBar from "../../assets/deskshift/menu-bar.png";
import popoverMoving from "../../assets/deskshift/popover-moving.png";
import positionEditor from "../../assets/deskshift/position-editor.png";
import postureCoach from "../../assets/deskshift/posture-coach.png";
import keyboardShortcuts from "../../assets/deskshift/keyboard-shortcuts.png";

const storeUrl = appStoreUrl("press");

const facts: Array<{ label: string; value: string; href?: string }> = [
  { label: "App", value: "DeskShift" },
  { label: "Made by", value: "Ionut Binisor, independent developer, Bucharest, Romania" },
  { label: "Platform", value: `macOS ${MIN_MACOS} or later, Mac App Store only` },
  { label: "First released", value: "July 5, 2026" },
  { label: "Price", value: `Free to download. Pro is a one-time purchase: ${PRO_PRICE}. Every install starts with a 14-day full Pro trial.` },
  { label: "Works with", value: "IKEA IDÅSEN (the tested desk). Other desks with a Linak Bluetooth controller on a best-effort basis." },
  { label: "Languages", value: "English and 39 more" },
  { label: "Privacy", value: "No account, no analytics, no tracking, no ads" },
  { label: "Mac App Store", value: "apps.apple.com/app/deskshift/id6773494854", href: storeUrl },
  { label: "Contact", value: SUPPORT_EMAIL, href: `mailto:${SUPPORT_EMAIL}` },
];

const highlights = [
  "Move the desk from the menu bar, with the live height next to the icon.",
  "Up to 12 named memory positions, each with its own icon.",
  "Posture Coach: reminders to switch positions, or the desk moves itself on a schedule.",
  "Global keyboard shortcuts for every position, and for up, down and stop.",
  "Desk actions in Spotlight, the Shortcuts app and Siri.",
  "Double-tap the desk's own button to jump to Sit or Stand.",
  "iCloud sync across Macs, and more than one desk.",
];

// Each tile shows an optimized thumbnail and links to the original PNG, which
// downloads under `file`.
const images = [
  { image: icon, file: "deskshift-icon-1024.png", caption: "App icon, 1024 × 1024" },
  { image: menuBar, file: "deskshift-menu-bar.png", caption: "The desk in the menu bar" },
  { image: popoverMoving, file: "deskshift-moving.png", caption: "Moving to Stand" },
  { image: positionEditor, file: "deskshift-position-editor.png", caption: "Editing a memory position" },
  { image: postureCoach, file: "deskshift-posture-coach.png", caption: "Posture Coach" },
  { image: keyboardShortcuts, file: "deskshift-keyboard-shortcuts.png", caption: "Keyboard shortcuts" },
];
---

<Base
  title="DeskShift — Press kit"
  description="Facts, copy, screenshots and the icon for writing about DeskShift, the Mac menu bar app for IKEA IDÅSEN standing desks."
  ogImage="/deskshift/og.png"
>
  <section class="space-y-4">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Press kit</h1>
    <p class="text-lg text-(--color-muted)">
      Everything you need to write about DeskShift. Use any of it freely. If
      something is missing, write to
      <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> and you'll hear
      back from me directly.
    </p>
    <p><a href="#images">Jump to the images ↓</a></p>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">In one sentence</h2>
    <p class="mt-4 text-lg">
      DeskShift puts an IKEA IDÅSEN standing desk in the Mac menu bar: one tap,
      one shortcut or a schedule moves it to the height you want.
    </p>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">In one paragraph</h2>
    <p class="mt-4 leading-relaxed">
      Many standing desks spend most of the day at sitting height. Changing position means
      stopping, reaching under the desk and holding a button until it gets
      there. DeskShift is a native Mac app that removes that step. It lives in
      the menu bar, remembers up to 12 named heights, and moves the desk from a
      tap, a keyboard shortcut, Spotlight, the Shortcuts app or Siri. Its
      Posture Coach reminds you to switch positions, or moves the desk for you
      on a schedule you set. There is no account, no tracking and no
      subscription: the basics are free and Pro is a one-time purchase.
    </p>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">Fact sheet</h2>
    <dl class="mt-6 divide-y divide-(--color-border)/60 rounded-2xl border border-(--color-border)">
      {
        facts.map((fact) => (
          <div class="grid gap-1 px-4 py-3 text-sm sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="font-medium">{fact.label}</dt>
            <dd class="text-(--color-muted)">
              {fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">What it does</h2>
    <ul class="mt-4 list-disc space-y-1 pl-5 text-(--color-muted)">
      {highlights.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section id="images" class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">Images</h2>
    <p class="mt-2 text-(--color-muted)">
      Click an image to download the full-size PNG.
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        images.map((item) => (
          <a
            href={item.image.src}
            download={item.file}
            class="block no-underline hover:no-underline"
          >
            <Image
              src={item.image}
              alt={item.caption}
              widths={[360, 720]}
              sizes="(min-width: 40rem) 21rem, 100vw"
              class="aspect-[8/5] w-full rounded-xl border border-(--color-border) bg-(--color-surface) object-contain"
            />
            <span class="mt-2 block text-sm text-(--color-muted)">
              {item.caption}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold tracking-tight">About the developer</h2>
    <p class="mt-4 leading-relaxed">
      Ionut Binisor is an iOS and macOS developer in Bucharest, Romania, writing
      Swift since 2017. DeskShift is a solo project: designed, built and
      supported by one person. <a href="/">More about Ionut →</a>
    </p>
  </section>

  <p class="mt-16 text-xs text-(--color-muted)">{DISCLAIMER}</p>
</Base>
